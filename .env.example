# FileKG 环境变量示例
# cp .env.example .env

# --- 嵌入模型（可选镜像）---
# HF_ENDPOINT=https://hf-mirror.com
# FILEKG_EMBEDDING_BACKEND=auto
# FILEKG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- API 安全（本地默认可不设置）---
# FILEKG_HOST=127.0.0.1
# FILEKG_PORT=8765
# FILEKG_API_TOKEN=change-me-in-production
# 在 config.yaml 设 api.require_token: true 后，请求需 Header: Authorization: Bearer <token>

# --- 索引路径 allowlist（config.yaml api.index_allow_roots 亦可）---
# FILEKG_API_INDEX_ALLOW_ROOTS=/Users/you/Documents,/Users/you/data

# --- 测试/CI 常用 ---
# FILEKG_INDEX_FAST=1
# FILEKG_API_MANUAL_LOAD=true
# FILEKG_API_HEARTBEAT_ENABLED=false

# --- DeepSeek RAG（可选）---
DEEPSEEK_API_KEY=

# --- Neo4j（可选，docker compose --profile neo4j）---
# FILEKG_NEO4J_URI=bolt://localhost:7687
# FILEKG_NEO4J_USER=neo4j
# FILEKG_NEO4J_PASSWORD=filekg123
